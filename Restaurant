function updWish(){const b=document.getElementById('wBadge');b.textContent=wish.length;b.style.display=wish.length?'flex':'none'}
function totals(){
  const sub=cart.reduce((s,c)=>s+c.p*c.qty,0);
  let disc=0;const code=coupon.toUpperCase();
  if(code==='SAVORA20')disc=Math.min(100,Math.round(sub*.2));
  else if(code==='FIRST50')disc=sub>=299?50:0;
  else if(code==='COMBO99')disc=sub>=499?99:0;
  const del=(sub>=499||code==='FREEDLV'||sub>=199&&code==='FREEDLV')?0:(sub>=199?0:40);
  // free delivery above 499 always, or FREEDLV if min 199
  const delivery=sub>=499?0:(code==='FREEDLV'&&sub>=199?0:40);
  const tax=Math.round((sub-disc)*.05);
  return{sub,disc,del:delivery,tax,tot:sub-disc+delivery+tax};
}
function updCart(){
  const n=cart.reduce((s,c)=>s+c.qty,0);
  const b=document.getElementById('cBadge');b.textContent=n;b.classList.remove('pop');void b.offsetWidth;b.classList.add('pop');
