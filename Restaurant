    <div class="rev-stars" id="revStarPick">${[1,2,3,4,5].map(s=>`<i class="fas fa-star" data-s="${s}" onclick="document.querySelectorAll('#revStarPick i').forEach((x,i)=>x.classList.toggle('on',i<s))"></i>`).join('')}</div>
    <div class="fld" style="margin-top:1rem"><label>Your experience</label><textarea id="revText" rows="3" placeholder="What did you love?"></textarea></div>
    <div class="fld"><label>Photo (UI only)</label><input type="file" accept="image/*"></div>
    <button class="btn btn-p btn-block" onclick="document.getElementById('qvM').classList.remove('open');toast('Review submitted (demo)');pushNotif('Thanks for reviewing','Your feedback helps other guests','system')">Submit review</button>`;
  m.classList.add('open');
}

/* Enhance profile */
const _renderProf=renderProf;
renderProf=function(){
  _renderProf();
  const box=document.getElementById('profBox');
  if(!box)return;
  const extra=`
    <div class="points-bar" style="margin-top:1rem"><div><div style="font-size:.78rem;opacity:.85">Loyalty points</div><strong style="font-size:1.3rem">${points} pts</strong></div><button class="btn btn-sm" style="background:#fff;color:var(--p)" onclick="go('settings')">Redeem</button></div>
    ${[['settings','Settings','fa-cog'],['notifs','Notifications','fa-bell'],['faq','Help & FAQ','fa-question-circle'],['reserve','Book a Table','fa-chair'],['reviews','Reviews','fa-star']].map(([pg,l,ic])=>`
      <div onclick="go('${pg}')" style="display:flex;align-items:center;gap:.8rem;padding:.9rem 1rem;background:var(--card);border:1px solid var(--border);border-radius:12px;margin-bottom:.5rem;cursor:pointer">
        <i class="fas ${ic}" style="color:var(--p);width:20px"></i><span style="flex:1;font-weight:500">${l}</span><i class="fas fa-chevron-right" style="color:var(--muted);font-size:.8rem"></i>
      </div>`).join('')}`;
  box.insertAdjacentHTML('beforeend',extra);
};

/* Recently viewed on home */
const _renderHome=renderHome;
renderHome=function(){
  _renderHome();
  if(recentViewed.length){
    const items=recentViewed.map(id=>ITEMS.find(i=>i.id===id)).filter(Boolean);
    const wrap=document.querySelector('#p-home .wrap');
    if(wrap&&items.length&&!document.getElementById('recentSec')){
      const sec=document.createElement('section');
      sec.id='recentSec';
      sec.innerHTML=`<div class="wrap"><div class="sh" style="text-align:left"><h2 style="font-size:1.2rem">Recently viewed</h2></div><div class="recent-row">${items.map(card).join('')}</div></div>`;
      const home=document.getElementById('p-home');
      const last=home.querySelector('section:last-of-type');
      if(last)last.before(sec);else home.appendChild(sec);
    } else if(document.getElementById('recentSec')){
      document.querySelector('#recentSec .recent-row').innerHTML=items.map(card).join('');
    }
  }
};

/* Patch go for new pages */
const _go=go;
go=function(id){
  _go(id);
  if(id==='notifs')renderNotifs();
  if(id==='settings')renderSettings();
  if(id==='faq')renderFAQ();
  if(id==='reserve')renderReserve();
  if(id==='reviews')renderReviews();
};

/* Keyboard: Esc closes overlays */
document.addEventListener('keydown',e=>{
  if(e.key==='Escape'){
    closeCart();closeLoc();closeSearch();closeFilter();
    document.getElementById('qvM')?.classList.remove('open');
    document.getElementById('lightbox')?.classList.remove('open');
  }
});

/* Init enhancements */
if(darkOn){document.body.setAttribute('data-dark','1');document.body.classList.add('dark-mode');const ic=document.getElementById('darkIcon');if(ic)ic.className='fas fa-sun'}
updNotifBadge();
if(!notifs.length){
  pushNotif('Welcome to Savora','Explore themes, order food, track delivery — all frontend demo','system');
  pushNotif('Offer unlocked','Use code FIRST50 for ₹50 off your first order','offer');
}

</script>
</body>
