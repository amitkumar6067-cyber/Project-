function startTrack(){
  if(trackTimer)clearInterval(trackTimer);
  if(!lastOrder)return;
  lastOrder.step=0;
  trackTimer=setInterval(()=>{
    if(!lastOrder||lastOrder.step>=4){clearInterval(trackTimer);if(lastOrder){lastOrder.status='done';lastOrder.step=4;save()}return}
    lastOrder.step++;
    if(lastOrder.step>=4){lastOrder.status='done';clearInterval(trackTimer)}
    save();
    if(document.getElementById('p-track').classList.contains('on'))renderTrack();
  },4000);
}

