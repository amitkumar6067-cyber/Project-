function save(){localStorage.setItem('sv_cart',JSON.stringify(cart));localStorage.setItem('sv_wish',JSON.stringify(wish));localStorage.setItem('sv_orders',JSON.stringify(orders));localStorage.setItem('sv_user',JSON.stringify(user));localStorage.setItem('sv_addr',JSON.stringify(addrs));localStorage.setItem('sv_theme',theme)}

function toast(m,ok=true){const t=document.getElementById('toast');document.getElementById('tmsg').textContent=m;t.querySelector('i').className=ok?'fas fa-check':'fas fa-exclamation';t.classList.add('show');setTimeout(()=>t.classList.remove('show'),2600)}

function setTheme(id){
  const t=THEMES.find(x=>x.id===id);if(!t)return;
  theme=id;document.body.setAttribute('data-theme',id);save();
  document.getElementById('hTag').textContent=t.tag;
  document.getElementById('hTitle').innerHTML=t.title;
  document.getElementById('hDesc').textContent=t.desc;
  document.getElementById('hImg').src=t.img;
  document.getElementById('bIcon').className='fas '+t.bi;
  document.getElementById('popTitle').textContent=t.l==='All'?'Most Loved':t.l+' Favourites';
  document.getElementById('menuSub').textContent='Exploring '+t.l;
  document.querySelectorAll('.tbtn').forEach(b=>b.classList.toggle('on',b.dataset.t===id));
  cat='all';renderHome();renderMenu();renderCrow();
  toast('Theme · '+t.l);
}

function buildThemes(){
  document.getElementById('trow').innerHTML=THEMES.map(t=>`<button class="tbtn ${t.id===theme?'on':''}" data-t="${t.id}" onclick="setTheme('${t.id}')"><div class="ti"><i class="fas ${t.icon}"></i></div>${t.l}</button>`).join('');
}

function filtered(){
  let list=ITEMS.slice();
  if(theme==='veg')list=list.filter(i=>i.v);
  else if(theme==='nonveg')list=list.filter(i=>!i.v);
  else if(theme!=='food')list=list.filter(i=>i.t.includes(theme));
  return list;
}

function card(i){
  const d=i.o?Math.round((1-i.p/i.o)*100):0,w=wish.includes(i.id);
  return `<div class="card" onclick="openDet(${i.id})">
    <div class="cimg"><img src="${i.img}" alt="${i.n}" loading="lazy" onerror="this.src='https://via.placeholder.com/400x300?text=Food'">
      ${i.b?`<span class="cbadge">${i.b}</span>`:''}
      ${d?`<span class="cbadge" style="left:auto;right:40px;background:var(--err)">${d}% OFF</span>`:''}
      <button class="cwish ${w?'on':''}" onclick="event.stopPropagation();togWish(${i.id})"><i class="${w?'fas':'far'} fa-heart"></i></button>
    </div>
    <div class="cbody">
      <h3>${i.n}</h3>
      <div class="cmeta"><span class="stars">★ ${i.r}</span><span>(${i.rv})</span><span>${i.v?'🟢':'🔴'}</span><span>· ${i.prep} min</span></div>
      <p class="cdesc">${i.d}</p>
      <div class="cfoot"><div class="price">₹${i.p}${i.o?` <s>₹${i.o}</s>`:''}</div>
      <button class="abtn" ${!restaurantOpen?'disabled':''} onclick="event.stopPropagation();addCart(${i.id})" aria-label="Add"><i class="fas fa-plus"></i></button></div>
    </div></div>`;
}

function renderHome(){
  const list=filtered().filter(i=>i.b||i.r>=4.7).slice(0,8);
  document.getElementById('homeGrid').innerHTML=list.map(card).join('')||'<p style="grid-column:1/-1;text-align:center;color:var(--muted)">No items</p>';
  document.getElementById('cats').innerHTML=CAT_VIS.map(c=>`<div class="catc" onclick="theme=c.id==='drinks'?'coffee':(c.id==='indian'||c.id==='continental'?'food':c.id);if(['pizza','burger','chinese','coffee'].includes(c.id))setTheme(c.id);else{cat=c.id;go('menu')}"><div class="ci">${c.e}</div><span>${c.l}</span></div>`).join('');
  const sp=filtered().find(i=>i.b==='Special')||filtered()[0];
  if(sp)document.getElementById('special').innerHTML=`<img src="${sp.img}" alt="${sp.n}"><div class="special-b"><span class="badge">Today's Special</span><h3>${sp.n}</h3><p>${sp.d}</p><div class="cmeta"><span class="stars">★ ${sp.r}</span><span>(${sp.rv} reviews)</span></div><div class="price">₹${sp.p}${sp.o?` <s>₹${sp.o}</s>`:''}</div><button class="btn btn-p btn-sm" ${!restaurantOpen?'disabled':''} onclick="addCart(${sp.id})">Add to Cart</button></div>`;
  document.getElementById('combos').innerHTML=COMBOS.map(c=>`<div class="combo"><img src="${c.img}" alt=""><div class="combo-b"><h3>${c.n}</h3><div class="items">${c.items}</div><div class="price">₹${c.p} <s>₹${c.o}</s></div><button class="btn btn-p btn-sm" style="margin-top:.4rem" onclick="addCombo('${c.n}',${c.p},'${c.img}')">Add Combo</button></div></div>`).join('');
}

