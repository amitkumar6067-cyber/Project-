  <div class="db" id="dbody"></div>
  <div class="df" id="dfoot" style="display:none">
    <div style="display:flex;justify-content:space-between;font-weight:700;margin-bottom:.7rem"><span>Total</span><span id="dtot">₹0</span></div>
    <button class="btn btn-p btn-block" onclick="closeCart();go('cart')">View Cart & Checkout</button>
  </div>
</div>

<!-- LOCATION MODAL -->
<div class="mbg" id="locM">
  <div class="modal">
    <div class="mh"><h3>Delivery location</h3><button class="cx" onclick="closeLoc()"><i class="fas fa-times"></i></button></div>
    <div class="fld"><label>Search area</label><input id="locSearch" placeholder="Search locality..."></div>
    <div id="addrList"></div>
    <button class="btn btn-od btn-block" style="margin-top:.8rem" onclick="toast('Add address — demo')">+ Add new address</button>
  </div>
</div>

<!-- QUICK VIEW -->
<div class="mbg" id="qvM">
  <div class="modal" id="qvBody"></div>
</div>


<!-- SEARCH OVERLAY -->
<div class="search-ov" id="searchOv">
  <div class="shd">
    <button class="cx" onclick="closeSearch()" aria-label="Close"><i class="fas fa-arrow-left"></i></button>
    <input id="liveSearch" placeholder="Search dishes, cuisines..." autocomplete="off" oninput="liveSuggest()">
  </div>
  <div class="search-body" id="searchBody"></div>
</div>

<!-- FILTER SHEET -->
<div class="ov" id="filtOv" onclick="closeFilter()"></div>
<div class="filter-sheet" id="filtSheet">
  <div class="mh"><h3>Filters</h3><button class="cx" onclick="closeFilter()"><i class="fas fa-times"></i></button></div>
  <div class="fld"><label>Max price: <span id="priceVal">₹500</span></label>
    <input type="range" id="priceRange" min="50" max="500" value="500" oninput="document.getElementById('priceVal').textContent='₹'+this.value">
  </div>
  <div class="fld"><label>Spice level</label>
    <select class="sel" id="spiceF" style="width:100%"><option value="">Any</option><option value="0">None</option><option value="1">Mild</option><option value="2">Medium</option><option value="3">Hot</option></select>
  </div>
  <div class="fld"><label>Prep time</label>
    <select class="sel" id="prepF" style="width:100%"><option value="">Any</option><option value="15">Under 15 min</option><option value="25">Under 25 min</option><option value="35">Under 35 min</option></select>
  </div>
  <button class="btn btn-p btn-block" onclick="applyFilters()">Apply filters</button>
</div>

<!-- LIGHTBOX -->
<div class="lightbox" id="lightbox" onclick="this.classList.remove('open')">
  <button class="cx" onclick="event.stopPropagation();document.getElementById('lightbox').classList.remove('open')"><i class="fas fa-times"></i></button>
  <img id="lbImg" src="" alt="">
</div>

<div class="confetti" id="confetti"></div>

<div class="toast" id="toast"><i class="fas fa-check"></i> <span id="tmsg"></span></div>
<div class="scart" id="scart" onclick="openCart()"><span id="scartT">View cart</span><span>→</span></div>

<nav class="bnav">
  <div class="bnav-in">
    <button class="bi on" data-p="home" onclick="go('home')"><i class="fas fa-home"></i>Home</button>
    <button class="bi" data-p="menu" onclick="go('menu')"><i class="fas fa-utensils"></i>Menu</button>
