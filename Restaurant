function chQty(id,d,note=''){
  const c=cart.find(x=>x.id==id&&(x.note||'')===note);
  if(!c)return;c.qty+=d;if(c.qty<=0)cart=cart.filter(x=>!(x.id==id&&(x.note||'')===note));
  save();updCart();if(document.getElementById('p-cart').classList.contains('on'))renderCartFull();
}
function togWish(id){
