  foot.style.display='block';
  const t=totals();document.getElementById('dtot').textContent='₹'+t.tot;
  const need=Math.max(0,499-t.sub),pct=Math.min(100,Math.round(t.sub/499*100));
  const upsell=ITEMS.filter(i=>['sides','drinks','dessert'].includes(i.c[0])&&!cart.find(c=>c.id===i.id)).slice(0,3);
  body.innerHTML=`
    ${need>0?`<div class="prog"><div style="font-size:.82rem">Add <strong>₹${need}</strong> more for <strong>FREE DELIVERY</strong></div><div class="prog-bar"><div class="prog-fill" style="width:${pct}%"></div></div></div>`
