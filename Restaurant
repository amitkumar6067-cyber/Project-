<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover"/>
<title>Savora — Good food. Good mood.</title>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400&family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
<style>
:root,[data-theme="food"]{
  --p:#c2410c;--p2:#9a3412;--p3:#ea580c;--soft:#fff7ed;--bg:#fafaf9;--card:#fff;--text:#1c1917;--muted:#78716c;
  --border:#e7e5e4;--ok:#16a34a;--warn:#d97706;--err:#dc2626;--hero-bg:#1c1917;--hero-fg:#fafaf9;
  --nav:rgba(250,250,249,.94);--foot:#1c1917;--radius:14px;--sh:0 4px 24px rgba(28,25,23,.07);--sh2:0 12px 40px rgba(28,25,23,.12);
}
[data-theme="coffee"]{
  --p:#a16207;--p2:#713f12;--p3:#ca8a04;--soft:#1c1917;--bg:#0c0a09;--card:#1c1917;--text:#fafaf9;--muted:#a8a29e;
  --border:#292524;--ok:#4ade80;--hero-bg:#0c0a09;--hero-fg:#fafaf9;--nav:rgba(12,10,9,.96);--foot:#0c0a09;
  --sh:0 4px 24px rgba(0,0,0,.4);--sh2:0 12px 40px rgba(0,0,0,.5);
}
[data-theme="tea"]{
  --p:#15803d;--p2:#166534;--p3:#22c55e;--soft:#f0fdf4;--bg:#f7fef9;--card:#fff;--text:#14532d;--muted:#4d7c5a;
  --border:#dcfce7;--ok:#15803d;--hero-bg:#14532d;--hero-fg:#f0fdf4;--nav:rgba(247,254,249,.96);--foot:#14532d;
}
[data-theme="pizza"]{
  --p:#dc2626;--p2:#b91c1c;--p3:#f97316;--soft:#fef2f2;--bg:#fffbfa;--card:#fff;--text:#1c1917;--muted:#78716c;
  --border:#fecaca;--ok:#16a34a;--hero-bg:#7f1d1d;--hero-fg:#fff;--nav:rgba(255,251,250,.96);--foot:#7f1d1d;
}
[data-theme="chinese"]{
  --p:#b91c1c;--p2:#991b1b;--p3:#ea580c;--soft:#fffbeb;--bg:#fffbeb;--card:#fff;--text:#1c1917;--muted:#78716c;
  --border:#fde68a;--ok:#16a34a;--hero-bg:#1c0a0a;--hero-fg:#fef3c7;--nav:rgba(255,251,235,.96);--foot:#1c0a0a;
}
[data-theme="burger"]{
  --p:#ca8a04;--p2:#a16207;--p3:#eab308;--soft:#1c1917;--bg:#0c0a09;--card:#1c1917;--text:#fefce8;--muted:#a8a29e;
  --border:#292524;--ok:#4ade80;--hero-bg:#1c1917;--hero-fg:#fefce8;--nav:rgba(12,10,9,.96);--foot:#0c0a09;
  --sh:0 4px 24px rgba(0,0,0,.4);--sh2:0 12px 40px rgba(0,0,0,.5);
}
[data-theme="veg"]{
  --p:#16a34a;--p2:#15803d;--p3:#4ade80;--soft:#f0fdf4;--bg:#f7fef9;--card:#fff;--text:#14532d;--muted:#4d7c5a;
  --border:#bbf7d0;--ok:#15803d;--hero-bg:#14532d;--hero-fg:#f0fdf4;--nav:rgba(247,254,249,.96);--foot:#14532d;
}
[data-theme="nonveg"]{
  --p:#c2410c;--p2:#9a3412;--p3:#ea580c;--soft:#fff7ed;--bg:#fafaf9;--card:#fff;--text:#1c1917;--muted:#78716c;
  --border:#fed7aa;--ok:#16a34a;--hero-bg:#431407;--hero-fg:#fff7ed;--nav:rgba(250,250,249,.96);--foot:#431407;
}
*{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth}
body{font-family:'DM Sans',system-ui,sans-serif;background:var(--bg);color:var(--text);line-height:1.5;overflow-x:hidden;transition:background .45s,color .35s}
h1,h2,h3,.logo{font-family:'Fraunces',Georgia,serif;font-weight:600;letter-spacing:-.02em}
img{max-width:100%;display:block}
button,input,select,textarea{font-family:inherit}
.page{display:none;min-height:60vh;animation:up .35s ease}
.page.on{display:block}
@keyframes up{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:none}}
@keyframes pop{0%{transform:scale(1)}40%{transform:scale(1.25)}100%{transform:scale(1)}}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:.4}}
@keyframes slideIn{from{transform:translateX(100%)}to{transform:none}}

/* NAV */
.nav{position:sticky;top:0;z-index:900;background:var(--nav);backdrop-filter:blur(14px);border-bottom:1px solid var(--border);padding:.65rem 4%;display:flex;align-items:center;justify-content:space-between;gap:1rem;transition:background .4s,border-color .4s}
.logo{font-size:1.45rem;cursor:pointer;display:flex;align-items:center;gap:8px;color:var(--text)}
.logo i{color:var(--p);transition:color .4s}
.nlinks{display:flex;gap:1.25rem;list-style:none}
.nlinks a{color:var(--muted);text-decoration:none;font-size:.875rem;font-weight:500;cursor:pointer;transition:color .2s}
.nlinks a:hover,.nlinks a.on{color:var(--p)}
.nact{display:flex;align-items:center;gap:.5rem}
.ib{width:38px;height:38px;border-radius:50%;border:1px solid var(--border);background:var(--card);color:var(--text);cursor:pointer;display:flex;align-items:center;justify-content:center;position:relative;transition:all .2s;font-size:.95rem}
.ib:hover{border-color:var(--p);color:var(--p)}
.bdg{position:absolute;top:-3px;right:-3px;background:var(--p);color:#fff;font-size:.62rem;min-width:16px;height:16px;border-radius:999px;display:flex;align-items:center;justify-content:center;font-weight:700;padding:0 4px}
.bdg.pop{animation:pop .35s ease}
.loc-btn{display:flex;align-items:center;gap:6px;padding:.4rem .75rem;border-radius:999px;border:1px solid var(--border);background:var(--card);cursor:pointer;font-size:.78rem;color:var(--text);max-width:160px}
.loc-btn strong{display:block;font-size:.8rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.loc-btn span{color:var(--muted);font-size:.68rem}
.mtog{display:none;background:none;border:none;font-size:1.25rem;color:var(--text);cursor:pointer}

/* STATUS */
.sbar{display:flex;flex-wrap:wrap;gap:.85rem;justify-content:center;align-items:center;padding:.55rem 4%;background:var(--card);border-bottom:1px solid var(--border);font-size:.78rem;color:var(--muted)}
.sbar .op{display:inline-flex;align-items:center;gap:5px;font-weight:600;color:var(--ok);background:color-mix(in srgb,var(--ok) 12%,transparent);padding:.2rem .65rem;border-radius:999px}
.sbar .op::before{content:'';width:6px;height:6px;background:var(--ok);border-radius:50%;animation:pulse 2s infinite}
.sbar.closed .op{color:var(--err);background:color-mix(in srgb,var(--err) 12%,transparent)}
.sbar.closed .op::before{background:var(--err);animation:none}

/* HERO */
.hero{background:var(--hero-bg);color:var(--hero-fg);padding:3rem 5% 3.5rem;display:grid;grid-template-columns:1.05fr .95fr;gap:2rem;align-items:center;position:relative;overflow:hidden;min-height:400px;transition:background .5s}
.hero::after{content:'';position:absolute;width:320px;height:320px;right:-60px;top:-80px;background:radial-gradient(circle,rgba(255,255,255,.06),transparent 70%);border-radius:50%;pointer-events:none}
.htag{display:inline-block;font-size:.72rem;font-weight:600;letter-spacing:.06em;text-transform:uppercase;opacity:.8;padding:.25rem .7rem;border:1px solid rgba(255,255,255,.2);border-radius:999px;margin-bottom:.75rem}
.hero h1{font-size:clamp(2rem,4.2vw,3.1rem);line-height:1.12;margin-bottom:.75rem}
.hero h1 em{font-style:normal;color:var(--p3)}
.hero p{opacity:.82;max-width:380px;margin-bottom:1.25rem;font-size:1rem}
.hstats{display:flex;flex-wrap:wrap;gap:1rem;margin-bottom:1.4rem;font-size:.82rem;opacity:.9}
.hstats strong{color:var(--p3)}
.hbtns{display:flex;gap:.7rem;flex-wrap:wrap}
.hvis{position:relative;display:flex;justify-content:center}
.hvis img{width:min(100%,400px);height:340px;object-fit:cover;border-radius:20px;box-shadow:0 20px 50px rgba(0,0,0,.35);transition:transform .5s}
.hvis:hover img{transform:scale(1.02)}
.fchip{position:absolute;background:var(--card);color:var(--text);padding:.5rem .9rem;border-radius:999px;font-size:.78rem;font-weight:600;box-shadow:var(--sh2);display:flex;align-items:center;gap:5px}
.fchip.a{top:16px;left:0}.fchip.b{bottom:24px;right:8px}

/* THEME BAR */
.tbar{padding:1rem 4%;background:var(--card);border-bottom:1px solid var(--border)}
.tbar-l{font-size:.68rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);text-align:center;margin-bottom:.6rem}
.trow{display:flex;gap:.5rem;overflow-x:auto;justify-content:center;scrollbar-width:none;padding-bottom:.3rem}
.trow::-webkit-scrollbar{display:none}
.tbtn{flex-shrink:0;display:flex;flex-direction:column;align-items:center;gap:5px;padding:.55rem .85rem;border-radius:12px;border:1.5px solid var(--border);background:var(--bg);cursor:pointer;color:var(--text);min-width:68px;transition:all .25s;font-size:.68rem;font-weight:600}
.tbtn:hover{border-color:var(--p);transform:translateY(-2px)}
.tbtn.on{background:var(--p);color:#fff;border-color:var(--p);box-shadow:0 4px 14px color-mix(in srgb,var(--p) 35%,transparent)}
.tbtn .ti{width:32px;height:32px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:1rem;background:color-mix(in srgb,var(--p) 12%,transparent)}
.tbtn.on .ti{background:rgba(255,255,255,.2)}

/* SECTIONS */
section{padding:2.5rem 4%}
.wrap{max-width:1120px;margin:0 auto}
.sh{text-align:center;margin-bottom:1.5rem}
.sh h2{font-size:clamp(1.4rem,2.8vw,1.85rem);margin-bottom:.25rem}
.sh p{color:var(--muted);font-size:.92rem}
.greeting{padding:1.25rem 4% 0;max-width:1120px;margin:0 auto}
.greeting h2{font-size:1.35rem;margin-bottom:.15rem}
.greeting p{color:var(--muted);font-size:.9rem}

/* CATEGORY VISUAL */
.cats{display:grid;grid-template-columns:repeat(auto-fill,minmax(100px,1fr));gap:.75rem}
.catc{text-align:center;padding:1rem .5rem;background:var(--card);border:1px solid var(--border);border-radius:var(--radius);cursor:pointer;transition:all .25s}
.catc:hover{transform:translateY(-3px);box-shadow:var(--sh);border-color:var(--p)}
.catc .ci{font-size:1.8rem;margin-bottom:.4rem}
.catc span{font-size:.78rem;font-weight:600}

/* SPECIAL EDITORIAL */
.special{display:grid;grid-template-columns:1.1fr 1fr;gap:1.5rem;background:var(--card);border:1px solid var(--border);border-radius:18px;overflow:hidden}
.special img{width:100%;height:100%;min-height:280px;object-fit:cover}
.special-b{padding:1.5rem;display:flex;flex-direction:column;justify-content:center}
.special-b .badge{display:inline-block;background:var(--p);color:#fff;font-size:.68rem;font-weight:700;padding:3px 8px;border-radius:6px;margin-bottom:.6rem;width:fit-content}
.special-b h3{font-size:1.4rem;margin-bottom:.4rem}
.special-b p{color:var(--muted);font-size:.9rem;margin-bottom:1rem}
.special-b .price{font-size:1.35rem;font-weight:700;color:var(--p);margin-bottom:1rem}
.special-b .price s{font-size:.9rem;color:var(--muted);font-weight:400}

/* GRID + CARDS */
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:1.15rem}
.card{background:var(--card);border:1px solid var(--border);border-radius:var(--radius);overflow:hidden;cursor:pointer;transition:all .3s cubic-bezier(.2,.8,.2,1);position:relative}
.card:hover{transform:translateY(-5px);box-shadow:var(--sh2)}
.cimg{height:160px;overflow:hidden;position:relative;background:var(--soft)}
.cimg img{width:100%;height:100%;object-fit:cover;transition:transform .45s}
.card:hover .cimg img{transform:scale(1.07)}
.cbadge{position:absolute;top:8px;left:8px;background:var(--p);color:#fff;font-size:.62rem;font-weight:700;padding:2px 7px;border-radius:5px;text-transform:uppercase;letter-spacing:.03em}
.cwish{position:absolute;top:8px;right:8px;width:30px;height:30px;border-radius:50%;background:rgba(255,255,255,.93);border:none;display:flex;align-items:center;justify-content:center;cursor:pointer;color:#999;z-index:2;transition:all .2s}
.cwish.on,.cwish:hover{color:#e11d48}
.cbody{padding:.9rem 1rem 1rem}
.cbody h3{font-size:.95rem;margin-bottom:.2rem;font-weight:600}
.cmeta{display:flex;align-items:center;gap:6px;font-size:.74rem;color:var(--muted);margin-bottom:.35rem}
.stars{color:#f59e0b;font-weight:600}
.cdesc{font-size:.78rem;color:var(--muted);margin-bottom:.65rem;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.cfoot{display:flex;align-items:center;justify-content:space-between}
.price{font-size:1.05rem;font-weight:700;color:var(--p)}
.price s{font-size:.78rem;color:var(--muted);font-weight:400;margin-left:3px}
.abtn{width:34px;height:34px;border-radius:9px;border:none;background:var(--p);color:#fff;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:all .2s}
.abtn:hover{transform:scale(1.08);background:var(--p2)}
.abtn:active{transform:scale(.9)}
.abtn:disabled{opacity:.4;cursor:not-allowed;transform:none}

/* BTNS */
.btn{display:inline-flex;align-items:center;justify-content:center;gap:7px;padding:.7rem 1.35rem;border-radius:999px;font-weight:600;font-size:.875rem;cursor:pointer;border:none;transition:all .22s}
.btn-p{background:var(--p);color:#fff;box-shadow:0 4px 14px color-mix(in srgb,var(--p) 30%,transparent)}
.btn-p:hover{background:var(--p2);transform:translateY(-1px)}
.btn-o{background:transparent;border:1.5px solid rgba(255,255,255,.45);color:inherit}
.btn-o:hover{background:rgba(255,255,255,.12)}
.btn-od{border:1.5px solid var(--p);color:var(--p);background:transparent}
.btn-od:hover{background:var(--p);color:#fff}
.btn-sm{padding:.4rem .9rem;font-size:.78rem}
.btn-block{width:100%}
.btn:disabled{opacity:.45;cursor:not-allowed;transform:none!important}

/* CONTROLS */
.ctrl{display:flex;gap:.6rem;flex-wrap:wrap;margin-bottom:1.1rem;align-items:center}
.search{flex:1;min-width:160px;position:relative}
.search input{width:100%;padding:.65rem 1rem .65rem 2.4rem;border:1.5px solid var(--border);border-radius:999px;background:var(--card);color:var(--text);font-size:.875rem;outline:none}
.search input:focus{border-color:var(--p)}
.search i{position:absolute;left:.9rem;top:50%;transform:translateY(-50%);color:var(--muted);font-size:.85rem}
.sel{padding:.65rem .9rem;border:1.5px solid var(--border);border-radius:999px;background:var(--card);color:var(--text);font-size:.82rem;cursor:pointer;outline:none}
.crow{display:flex;gap:.5rem;overflow-x:auto;padding-bottom:.5rem;scrollbar-width:thin;margin-bottom:.8rem}
.cpill{flex-shrink:0;padding:.45rem 1rem;border-radius:999px;border:1.5px solid var(--border);background:var(--card);color:var(--text);font-weight:600;font-size:.8rem;cursor:pointer;transition:all .2s}
.cpill.on,.cpill:hover{background:var(--p);color:#fff;border-color:var(--p)}

/* DRAWER / OVERLAY */
.ov{position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:2000;opacity:0;visibility:hidden;transition:all .3s}
.ov.open{opacity:1;visibility:visible}
.drawer{position:fixed;top:0;right:-100%;width:min(400px,95vw);height:100%;background:var(--card);z-index:2001;display:flex;flex-direction:column;transition:right .35s cubic-bezier(.2,.8,.2,1),background .4s;box-shadow:-10px 0 40px rgba(0,0,0,.2)}
.drawer.open{right:0}
.dh{padding:1.1rem 1.2rem;border-bottom:1px solid var(--border);display:flex;justify-content:space-between;align-items:center}
.dh h3{font-size:1.1rem}
.cx{background:none;border:none;font-size:1.2rem;cursor:pointer;color:var(--muted)}
.db{flex:1;overflow-y:auto;padding:1rem 1.2rem}
.df{padding:1.1rem 1.2rem;border-top:1px solid var(--border);background:var(--bg)}
.ci{display:flex;gap:10px;padding:.7rem 0;border-bottom:1px solid var(--border);align-items:center}
.ci img{width:52px;height:52px;border-radius:10px;object-fit:cover}
.ci-i{flex:1;min-width:0}
.ci-i h4{font-size:.88rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.ci-i .sub{font-size:.72rem;color:var(--muted)}
.qty{display:inline-flex;align-items:center;border:1px solid var(--border);border-radius:999px;overflow:hidden;margin-top:3px}
.qty button{width:26px;height:26px;border:none;background:transparent;color:var(--text);cursor:pointer;font-size:.9rem}
.qty button:hover{background:var(--p);color:#fff}
.qty span{min-width:26px;text-align:center;font-weight:600;font-size:.82rem}

/* PROGRESS FREE DEL */
.prog{background:var(--card);border:1px solid var(--border);border-radius:12px;padding:.8rem 1rem;margin-bottom:.9rem}
.prog-bar{height:5px;background:var(--border);border-radius:3px;overflow:hidden;margin-top:.45rem}
.prog-fill{height:100%;background:var(--ok);border-radius:3px;transition:width .4s}

/* MODAL */
.mbg{position:fixed;inset:0;background:rgba(0,0,0,.55);z-index:3000;display:flex;align-items:flex-end;justify-content:center;padding:0;opacity:0;visibility:hidden;transition:all .3s}
.mbg.open{opacity:1;visibility:visible}
.modal{background:var(--card);border-radius:20px 20px 0 0;width:100%;max-width:480px;max-height:92vh;overflow-y:auto;padding:1.4rem;transform:translateY(40px);transition:transform .3s,background .4s}
.mbg.open .modal{transform:none}
@media(min-width:520px){.mbg{align-items:center;padding:1rem}.modal{border-radius:18px;transform:scale(.95)}.mbg.open .modal{transform:scale(1)}}
.mh{display:flex;justify-content:space-between;align-items:center;margin-bottom:1rem}
.mh h3{font-size:1.15rem}

/* TOAST */
.toast{position:fixed;bottom:80px;left:50%;transform:translateX(-50%) translateY(60px);background:var(--text);color:var(--bg);padding:.7rem 1.25rem;border-radius:12px;font-weight:500;font-size:.85rem;z-index:5000;opacity:0;transition:all .3s;display:flex;align-items:center;gap:7px;box-shadow:var(--sh2);max-width:90vw}
.toast.show{transform:translateX(-50%) translateY(0);opacity:1}

/* EMPTY */
.empty{text-align:center;padding:2.5rem 1rem;color:var(--muted)}
.empty i{font-size:2.5rem;opacity:.3;margin-bottom:.6rem}
.empty h3{color:var(--text);margin-bottom:.3rem;font-size:1.1rem}

/* BOTTOM NAV */
.bnav{display:none;position:fixed;bottom:0;left:0;right:0;z-index:1500;background:var(--card);border-top:1px solid var(--border);padding:.35rem 0 calc(.35rem + env(safe-area-inset-bottom))}
.bnav-in{display:flex;justify-content:space-around;max-width:420px;margin:0 auto}
.bi{display:flex;flex-direction:column;align-items:center;gap:2px;background:none;border:none;color:var(--muted);font-size:.6rem;font-weight:600;padding:.3rem .4rem;cursor:pointer}
.bi i{font-size:1.15rem}
.bi.on{color:var(--p)}

/* FOOTER */
footer{background:var(--foot);color:#a8a29e;padding:2.2rem 4% 1.3rem;margin-top:2rem}
.fg{display:grid;grid-template-columns:1.4fr 1fr 1fr 1fr;gap:1.5rem;margin-bottom:1.3rem;max-width:1120px;margin-left:auto;margin-right:auto}
.fg .logo{color:#fff;margin-bottom:.4rem}
.fg h4{color:#fff;font-size:.85rem;margin-bottom:.6rem;font-family:'DM Sans',sans-serif}
.fg a{color:#a8a29e;text-decoration:none;font-size:.82rem;display:block;margin-bottom:.3rem;cursor:pointer}
.fg a:hover{color:var(--p)}
.fb{border-top:1px solid rgba(255,255,255,.08);padding-top:1rem;text-align:center;font-size:.78rem;max-width:1120px;margin:0 auto}

/* CHECKOUT STEPS */
.steps{display:flex;gap:.4rem;margin-bottom:1.3rem}
.step{flex:1;text-align:center;padding:.5rem .3rem;border-radius:8px;font-size:.72rem;font-weight:600;background:var(--border);color:var(--muted)}
.step.on{background:var(--p);color:#fff}
.step.done{background:color-mix(in srgb,var(--ok) 18%,transparent);color:var(--ok)}

/* TRACK */
.tl{position:relative;padding-left:1.8rem}
.tl::before{content:'';position:absolute;left:7px;top:8px;bottom:8px;width:2px;background:var(--border)}
.ti{position:relative;padding-bottom:1.4rem}
.ti:last-child{padding-bottom:0}
.ti .dot{position:absolute;left:-1.8rem;width:16px;height:16px;border-radius:50%;border:2px solid var(--border);background:var(--card);top:2px}
.ti.done .dot{background:var(--ok);border-color:var(--ok)}
.ti.cur .dot{background:var(--p);border-color:var(--p);box-shadow:0 0 0 4px color-mix(in srgb,var(--p) 25%,transparent)}
.ti h4{font-size:.9rem;margin-bottom:.15rem}
.ti p{font-size:.78rem;color:var(--muted)}

/* FORM */
.fld{margin-bottom:.85rem}
.fld label{display:block;font-size:.8rem;font-weight:500;margin-bottom:.3rem;color:var(--muted)}
.fld input,.fld select,.fld textarea{width:100%;padding:.7rem .9rem;border:1.5px solid var(--border);border-radius:10px;background:var(--bg);color:var(--text);font-size:.9rem;outline:none}
.fld input:focus,.fld select:focus,.fld textarea:focus{border-color:var(--p)}
.pay-opt{display:flex;align-items:center;gap:.7rem;padding:.85rem 1rem;border:1.5px solid var(--border);border-radius:12px;margin-bottom:.5rem;cursor:pointer;transition:all .2s}
.pay-opt.on{border-color:var(--p);background:color-mix(in srgb,var(--p) 8%,transparent)}
.pay-opt input{accent-color:var(--p)}

/* DETAIL */
.det{max-width:1000px;margin:0 auto;padding:1.2rem 4%;display:grid;grid-template-columns:1fr 1.05fr;gap:1.8rem}
.det-img{border-radius:16px;overflow:hidden;height:340px}
.det-img img{width:100%;height:100%;object-fit:cover}
.back{display:inline-flex;align-items:center;gap:5px;background:none;border:none;color:var(--p);font-weight:600;cursor:pointer;font-size:.88rem;margin:1rem 4% 0}

/* STICKY CART MOBILE */
.scart{display:none;position:fixed;bottom:64px;left:12px;right:12px;z-index:1400;background:var(--p);color:#fff;padding:.85rem 1.1rem;border-radius:14px;font-weight:600;font-size:.9rem;cursor:pointer;box-shadow:0 8px 24px color-mix(in srgb,var(--p) 40%,transparent);align-items:center;justify-content:space-between}
.scart.show{display:flex}

/* COMBO */
.combos{display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:1rem}
.combo{display:grid;grid-template-columns:100px 1fr;background:var(--card);border:1px solid var(--border);border-radius:var(--radius);overflow:hidden;transition:all .25s}
.combo:hover{box-shadow:var(--sh);transform:translateY(-2px)}
.combo img{width:100px;height:100%;min-height:100px;object-fit:cover}
.combo-b{padding:.8rem}
.combo-b h3{font-size:.9rem;margin-bottom:.15rem}
.combo-b .items{font-size:.72rem;color:var(--muted);margin-bottom:.4rem}

/* DEMO BANNER */
.demo{background:linear-gradient(90deg,var(--p),var(--p2));color:#fff;text-align:center;padding:.5rem 1rem;font-size:.82rem;display:flex;align-items:center;justify-content:center;gap:.8rem;flex-wrap:wrap}
.demo button{background:#fff;color:var(--p);border:none;padding:.3rem .8rem;border-radius:999px;font-weight:600;font-size:.78rem;cursor:pointer}

/* RESPONSIVE */
@media(max-width:900px){
  .hero{grid-template-columns:1fr;text-align:center;min-height:auto;padding:2.2rem 4%}
  .hero p,.hstats{margin-left:auto;margin-right:auto}
  .hbtns{justify-content:center}
  .hvis{order:-1}.hvis img{height:240px}
  .fchip{display:none}
  .special{grid-template-columns:1fr}
  .det{grid-template-columns:1fr}
  .fg{grid-template-columns:1fr 1fr}
}
@media(max-width:720px){
  .nlinks{display:none;position:absolute;top:100%;left:0;right:0;background:var(--card);flex-direction:column;padding:1rem;gap:.7rem;border-bottom:1px solid var(--border);box-shadow:var(--sh)}
  .nlinks.open{display:flex}
  .mtog{display:block}
  .bnav{display:block}
  body{padding-bottom:72px}
  .fg{grid-template-columns:1fr}
  .loc-btn{display:none}
}


/* ===== ENHANCED POLISH ===== */
.ann{background:var(--text);color:var(--bg);font-size:.78rem;padding:.4rem 1rem;text-align:center;overflow:hidden;white-space:nowrap}
.ann span{display:inline-block;animation:marquee 18s linear infinite}
@keyframes marquee{0%{transform:translateX(100%)}100%{transform:translateX(-100%)}}
.dark-tog{width:38px;height:38px;border-radius:50%;border:1px solid var(--border);background:var(--card);cursor:pointer;display:flex;align-items:center;justify-content:center;color:var(--text);font-size:.95rem}
.search-ov{position:fixed;inset:0;z-index:3500;background:var(--bg);display:none;flex-direction:column}
.search-ov.open{display:flex}
.search-ov .shd{padding:1rem;border-bottom:1px solid var(--border);display:flex;gap:.6rem;align-items:center}
.search-ov input{flex:1;padding:.75rem 1rem;border:1.5px solid var(--border);border-radius:999px;background:var(--card);color:var(--text);font-size:1rem;outline:none}
.search-ov input:focus{border-color:var(--p)}
.search-body{flex:1;overflow-y:auto;padding:1rem}
.sug{padding:.7rem .9rem;border-radius:10px;cursor:pointer;display:flex;align-items:center;gap:.7rem;font-size:.9rem;transition:background .15s}
.sug:hover{background:var(--card)}
.sk{background:linear-gradient(90deg,var(--border) 25%,color-mix(in srgb,var(--border) 60%,var(--card)) 50%,var(--border) 75%);background-size:200% 100%;animation:shimmer 1.2s infinite;border-radius:8px}
@keyframes shimmer{0%{background-position:200% 0}100%{background-position:-200% 0}}
.sk-card{height:220px;border-radius:var(--radius)}
.confetti{position:fixed;inset:0;pointer-events:none;z-index:6000;overflow:hidden}
.confetti i{position:absolute;width:8px;height:8px;border-radius:2px;animation:fall 2.5s ease-out forwards}
@keyframes fall{0%{transform:translateY(-20px) rotate(0);opacity:1}100%{transform:translateY(100vh) rotate(720deg);opacity:0}}
.tip-row{display:flex;gap:.5rem;flex-wrap:wrap;margin:.8rem 0}
.tip-btn{padding:.45rem .9rem;border-radius:999px;border:1.5px solid var(--border);background:var(--card);cursor:pointer;font-size:.82rem;font-weight:600;color:var(--text)}
.tip-btn.on{border-color:var(--p);background:var(--p);color:#fff}
.notif-item{padding:.9rem;border-bottom:1px solid var(--border);display:flex;gap:.8rem;cursor:pointer}
.notif-item.unread{background:color-mix(in srgb,var(--p) 6%,transparent)}
.badge-nut{display:inline-block;font-size:.65rem;padding:2px 6px;border-radius:4px;background:var(--soft);color:var(--p);font-weight:600;margin-right:4px}
.rev-stars{display:flex;gap:4px;font-size:1.4rem;cursor:pointer;color:var(--border)}
.rev-stars i.on{color:#f59e0b}
.lightbox{position:fixed;inset:0;z-index:4000;background:rgba(0,0,0,.9);display:none;align-items:center;justify-content:center;padding:1rem}
.lightbox.open{display:flex}
.lightbox img{max-width:95%;max-height:90vh;border-radius:12px}
.lightbox .cx{position:absolute;top:1rem;right:1rem;color:#fff;font-size:1.5rem;background:none;border:none;cursor:pointer}
.lang-btn{font-size:.75rem;padding:.25rem .6rem;border-radius:6px;border:1px solid var(--border);background:var(--card);cursor:pointer;color:var(--text)}
.points-bar{background:linear-gradient(135deg,var(--p),var(--p2));color:#fff;border-radius:14px;padding:1rem 1.2rem;margin-bottom:1rem;display:flex;justify-content:space-between;align-items:center}
.recent-row{display:flex;gap:.8rem;overflow-x:auto;padding-bottom:.5rem}
.recent-row .card{min-width:160px;max-width:180px;flex-shrink:0}
.faq-q{padding:1rem;border:1px solid var(--border);border-radius:12px;margin-bottom:.5rem;cursor:pointer;background:var(--card)}
.faq-q h4{font-size:.92rem;display:flex;justify-content:space-between;align-items:center}
.faq-a{font-size:.85rem;color:var(--muted);margin-top:.5rem;display:none}
.faq-q.open .faq-a{display:block}
.reserve-card{background:var(--card);border:1px solid var(--border);border-radius:14px;padding:1.2rem;margin-top:1rem}
.share-btn{width:34px;height:34px;border-radius:9px;border:1px solid var(--border);background:var(--card);cursor:pointer;color:var(--text)}
.filter-sheet{position:fixed;bottom:0;left:0;right:0;z-index:3200;background:var(--card);border-radius:20px 20px 0 0;padding:1.4rem;transform:translateY(100%);transition:transform .35s;max-height:80vh;overflow-y:auto;box-shadow:0 -8px 40px rgba(0,0,0,.2)}
.filter-sheet.open{transform:none}
.range-labels{display:flex;justify-content:space-between;font-size:.78rem;color:var(--muted);margin-top:.3rem}
body.dark-mode,[data-dark="1"]{
  --bg:#0c0a09;--card:#1c1917;--text:#fafaf9;--muted:#a8a29e;--border:#292524;
