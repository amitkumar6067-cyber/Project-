  <div class="onboard" id="onboard" role="dialog" aria-labelledby="onboardTitle">
    <div class="onboard-card">
      <div style="font-size:40px;margin-bottom:12px;">✨</div>
      <h2 id="onboardTitle">Welcome to QR Magic Pro</h2>
      <p>Create professional QR codes for links, Wi-Fi, WhatsApp, contacts & more.</p>
      <ol class="onboard-steps"><li>Choose a <strong>QR type</strong> from the tabs</li><li>Fill details & customize colors / logo</li><li>Download PNG, JPG or SVG — or save to history</li></ol>
      <button type="button" class="btn btn-primary" id="onboardClose" style="width:100%;">Get started</button>
    </div>
  </div>
  <div class="modal-backdrop" id="renameModal"><div class="modal"><h3>Rename QR</h3><div class="field"><label for="renameInput">Name</label><input type="text" id="renameInput" /></div><div class="btn-row"><button type="button" class="btn btn-primary" id="renameConfirm">Save</button><button type="button" class="btn btn-ghost" id="renameCancel">Cancel</button></div></div></div>
  <div class="modal-backdrop" id="helpModal"><div class="modal"><h3>Keyboard shortcuts</h3><p style="font-size:0.88rem;color:var(--text-secondary);line-height:1.8;margin-bottom:16px;"><span class="kbd">Ctrl</span> + <span class="kbd">Enter</span> — Generate<br /><span class="kbd">T</span> — Toggle theme<br /><span class="kbd">?</span> — This help<br /><span class="kbd">Esc</span> — Close modals</p><p style="font-size:0.82rem;color:var(--text-muted);">Tip: Use High (H) error correction when adding a logo so the QR still scans reliably.</p><div class="btn-row"><button type="button" class="btn btn-primary" id="helpClose">Got it</button></div></div></div>
  <div class="toast" id="toast" role="status" aria-live="polite"></div>
  <script>

(function () {
  'use strict';
  var currentType = 'url';
  var logoDataUrl = null;
  var currentCanvas = null;
  var currentPayload = '';
  var historyItems = [];
  var renameId = null;
  var debounceTimer = null;
  var STORAGE_KEY = 'qrmagic_history_v2';
  var THEME_KEY = 'qrmagic_theme';
  var ONBOARD_KEY = 'qrmagic_onboarded';

  var $ = function (id) { return document.getElementById(id); };
  var contentFields = {
    url: $('urlInput'), text: $('textInput'),
    wifiSsid: $('wifiSsid'), wifiPass: $('wifiPass'), wifiEnc: $('wifiEnc'), wifiHidden: $('wifiHidden'),
    waPhone: $('waPhone'), waMsg: $('waMsg'),
    emailTo: $('emailTo'), emailSub: $('emailSub'), emailBody: $('emailBody'),
    phoneNum: $('phoneNum'),
    vcFirst: $('vcFirst'), vcLast: $('vcLast'), vcOrg: $('vcOrg'), vcTitle: $('vcTitle'),
    vcPhone: $('vcPhone'), vcEmail: $('vcEmail'), vcUrl: $('vcUrl'),
    smsPhone: $('smsPhone'), smsBody: $('smsBody')
  };

  function toast(msg) {
    var el = $('toast');
    el.textContent = msg;
    el.classList.add('show');
    clearTimeout(el._t);
    el._t = setTimeout(function () { el.classList.remove('show'); }, 2600);
  }

  function applyTheme(t) {
    document.documentElement.setAttribute('data-theme', t);
    try { localStorage.setItem(THEME_KEY, t); } catch (e) {}
  }
  function toggleTheme() {
    var cur = document.documentElement.getAttribute('data-theme') || 'dark';
    applyTheme(cur === 'dark' ? 'light' : 'dark');
    toast(cur === 'dark' ? 'Light mode' : 'Dark mode');
  }
  (function initTheme() {
    var saved = null;
    try { saved = localStorage.getItem(THEME_KEY); } catch (e) {}
    if (saved) applyTheme(saved);
    else if (window.matchMedia && window.matchMedia('(prefers-color-scheme: light)').matches) applyTheme('light');
  })();
  $('themeBtn').addEventListener('click', toggleTheme);

  try { if (!localStorage.getItem(ONBOARD_KEY)) $('onboard').classList.add('show'); } catch (e) {}
  $('onboardClose').addEventListener('click', function () {
    $('onboard').classList.remove('show');
    try { localStorage.setItem(ONBOARD_KEY, '1'); } catch (e) {}
  });

  document.querySelectorAll('.type-tab').forEach(function (tab) {
    tab.addEventListener('click', function () {
      document.querySelectorAll('.type-tab').forEach(function (t) {
        t.classList.remove('active'); t.setAttribute('aria-selected', 'false');
      });
      tab.classList.add('active'); tab.setAttribute('aria-selected', 'true');
      currentType = tab.getAttribute('data-type');
      document.querySelectorAll('.type-panel').forEach(function (p) {
        p.classList.toggle('active', p.getAttribute('data-panel') === currentType);
      });
      maybeAuto();
    });
  });

  function buildPayload() {
    switch (currentType) {
      case 'url': {
        var u = contentFields.url.value.trim();
        if (!u) return '';
        if (!/^https?:\/\//i.test(u) && u.indexOf('.') !== -1) u = 'https://' + u;
        return u;
      }
      case 'text': return contentFields.text.value.trim();
      case 'wifi': {
        var ssid = contentFields.wifiSsid.value.trim();
        if (!ssid) return '';
        var pass = contentFields.wifiPass.value;
        var enc = contentFields.wifiEnc.value;
        var hidden = contentFields.wifiHidden.checked ? 'H:true;' : '';
        return 'WIFI:T:' + enc + ';S:' + escapeWifi(ssid) + ';P:' + escapeWifi(pass) + ';' + hidden + ';';
      }
      case 'whatsapp': {
        var ph = contentFields.waPhone.value.replace(/\D/g, '');
        if (!ph) return '';
        var msg = contentFields.waMsg.value.trim();
        var link = 'https://wa.me/' + ph;
        if (msg) link += '?text=' + encodeURIComponent(msg);
        return link;
      }
      case 'email': {
        var to = contentFields.emailTo.value.trim();
        if (!to) return '';
        var sub = contentFields.emailSub.value.trim();
        var body = contentFields.emailBody.value.trim();
        var mailto = 'mailto:' + to;
        var params = [];
        if (sub) params.push('subject=' + encodeURIComponent(sub));
        if (body) params.push('body=' + encodeURIComponent(body));
        if (params.length) mailto += '?' + params.join('&');
        return mailto;
      }
      case 'phone': {
        var n = contentFields.phoneNum.value.trim();
        return n ? 'tel:' + n.replace(/\s/g, '') : '';
      }
      case 'vcard': {
        var fn = contentFields.vcFirst.value.trim();
        var ln = contentFields.vcLast.value.trim();
        if (!fn && !ln) return '';
        var lines = ['BEGIN:VCARD', 'VERSION:3.0'];
        lines.push('N:' + ln + ';' + fn + ';;;');
        lines.push('FN:' + (fn + ' ' + ln).trim());
        if (contentFields.vcOrg.value.trim()) lines.push('ORG:' + contentFields.vcOrg.value.trim());
        if (contentFields.vcTitle.value.trim()) lines.push('TITLE:' + contentFields.vcTitle.value.trim());
        if (contentFields.vcPhone.value.trim()) lines.push('TEL;TYPE=CELL:' + contentFields.vcPhone.value.trim());
        if (contentFields.vcEmail.value.trim()) lines.push('EMAIL:' + contentFields.vcEmail.value.trim());
        if (contentFields.vcUrl.value.trim()) lines.push('URL:' + contentFields.vcUrl.value.trim());
        lines.push('END:VCARD');
        return lines.join('\n');
      }
      case 'sms': {
        var sp = contentFields.smsPhone.value.trim().replace(/\s/g, '');
        if (!sp) return '';
        var sb = contentFields.smsBody.value.trim();
        var s = 'sms:' + sp;
        if (sb) s += '?body=' + encodeURIComponent(sb);
        return s;
      }
      default: return '';
    }
  }
  function escapeWifi(s) { return String(s).replace(/([\\;,:"])/g, '\\$1'); }
  function defaultName() {
    var names = { url: 'Website QR', text: 'Text QR', wifi: 'Wi-Fi QR', whatsapp: 'WhatsApp QR', email: 'Email QR', phone: 'Phone QR', vcard: 'Contact QR', sms: 'SMS QR' };
    var custom = $('qrName').value.trim();
    return custom || (names[currentType] || 'QR Code') + ' ' + new Date().toLocaleDateString();
  }

  $('margin').addEventListener('input', function () { $('marginVal').textContent = this.value; maybeAuto(); });
  $('logoSize').addEventListener('input', function () { $('logoSizeVal').textContent = this.value + '%'; if (logoDataUrl) maybeAuto(); });
  $('useGradient').addEventListener('change', function () { $('gradRow').style.display = this.checked ? 'grid' : 'none'; maybeAuto(); });
  $('gradColor1').addEventListener('input', maybeAuto);
  $('gradColor2').addEventListener('input', maybeAuto);
  $('fgColor').addEventListener('input', function () { document.querySelectorAll('.preset').forEach(function (p) { p.classList.remove('active'); }); maybeAuto(); });
  $('bgColor').addEventListener('input', function () { document.querySelectorAll('.preset').forEach(function (p) { p.classList.remove('active'); }); maybeAuto(); });
  $('size').addEventListener('change', maybeAuto);
  $('level').addEventListener('change', maybeAuto);

  $('presets').addEventListener('click', function (e) {
    var btn = e.target.closest('.preset');
    if (!btn) return;
    document.querySelectorAll('.preset').forEach(function (p) { p.classList.remove('active'); });
    btn.classList.add('active');
    $('fgColor').value = btn.getAttribute('data-fg');
    $('bgColor').value = btn.getAttribute('data-bg');
    $('useGradient').checked = false;
    $('gradRow').style.display = 'none';
    maybeAuto();
  });

  var TPL = {
    classic: { fg: '#1e1b4b', bg: '#ffffff', grad: false },
    brand: { fg: '#7c3aed', bg: '#f5f3ff', grad: true, g1: '#8b5cf6', g2: '#ec4899' },
    ocean: { fg: '#0e7490', bg: '#ecfeff', grad: true, g1: '#06b6d4', g2: '#3b82f6' },
    sunset: { fg: '#c2410c', bg: '#fff7ed', grad: true, g1: '#f97316', g2: '#ec4899' },
    dark: { fg: '#ffffff', bg: '#0f172a', grad: false },
    mint: { fg: '#047857', bg: '#ecfdf5', grad: true, g1: '#10b981', g2: '#14b8a6' }
  };
  $('templates').addEventListener('click', function (e) {
    var btn = e.target.closest('.tpl-btn');
    if (!btn) return;
    var t = TPL[btn.getAttribute('data-tpl')];
    if (!t) return;
    $('fgColor').value = t.fg; $('bgColor').value = t.bg;
    $('useGradient').checked = !!t.grad;
    $('gradRow').style.display = t.grad ? 'grid' : 'none';
    if (t.g1) $('gradColor1').value = t.g1;
    if (t.g2) $('gradColor2').value = t.g2;
    document.querySelectorAll('.preset').forEach(function (p) { p.classList.remove('active'); });
    maybeAuto(); toast('Template applied');
  });

  function loadLogo(file) {
    if (!file || !file.type || file.type.indexOf('image/') !== 0) { toast('Please choose an image file'); return; }
    if (file.size > 5 * 1024 * 1024) { toast('Image must be under 5MB'); return; }
    var reader = new FileReader();
    reader.onload = function (ev) {
      logoDataUrl = ev.target.result;
      $('logoImg').src = logoDataUrl;
      $('logoRow').classList.add('show');
      if ($('level').value === 'L' || $('level').value === 'M') $('level').value = 'H';
      maybeAuto(); toast('Logo loaded');
    };
    reader.onerror = function () { toast('Failed to load image'); };
    reader.readAsDataURL(file);
  }
  $('logoInput').addEventListener('change', function (e) { if (e.target.files && e.target.files[0]) loadLogo(e.target.files[0]); });
  $('removeLogo').addEventListener('click', function () {
    logoDataUrl = null; $('logoInput').value = ''; $('logoRow').classList.remove('show'); maybeAuto(); toast('Logo removed');
  });
  var dropZone = $('dropZone');
  ['dragenter', 'dragover'].forEach(function (ev) {
    dropZone.addEventListener(ev, function (e) { e.preventDefault(); e.stopPropagation(); dropZone.classList.add('drag'); });
  });
  ['dragleave', 'drop'].forEach(function (ev) {
    dropZone.addEventListener(ev, function (e) { e.preventDefault(); e.stopPropagation(); dropZone.classList.remove('drag'); });
  });
  dropZone.addEventListener('drop', function (e) { var f = e.dataTransfer.files[0]; if (f) loadLogo(f); });

  Object.keys(contentFields).forEach(function (k) {
    var el = contentFields[k]; if (!el) return;
    el.addEventListener('input', maybeAuto); el.addEventListener('change', maybeAuto);
  });
  function maybeAuto() { if ($('autoGenerate').checked && buildPayload()) scheduleGenerate(); }
  function scheduleGenerate() { clearTimeout(debounceTimer); debounceTimer = setTimeout(generateQR, 320); }

  function setLoading(on) { $('loading').classList.toggle('show', on); }

  function generateQR() {
    var payload = buildPayload();
    if (!payload) { toast('Fill in the required fields'); return; }
    if (typeof QRCode === 'undefined') { toast('QR library not loaded — check internet'); return; }
    currentPayload = payload;
    setLoading(true);
    $('qrcode').innerHTML = '';
    currentCanvas = null;
    $('qrFrame').classList.remove('empty');
    $('exportRow').style.display = 'none';
    $('metaText').textContent = '';
    var size = parseInt($('size').value, 10) || 256;
    var marginExtra = parseInt($('margin').value, 10) || 2;
    var levelMap = { L: QRCode.CorrectLevel.L, M: QRCode.CorrectLevel.M, Q: QRCode.CorrectLevel.Q, H: QRCode.CorrectLevel.H };
    var fg = $('fgColor').value, bg = $('bgColor').value;
    var holder = document.createElement('div');
    holder.style.cssText = 'position:absolute;left:-9999px;top:0;visibility:hidden;';
    document.body.appendChild(holder);
    try {
      new QRCode(holder, { text: payload, width: size, height: size, colorDark: fg, colorLight: bg, correctLevel: levelMap[$('level').value] || QRCode.CorrectLevel.M });
    } catch (err) {
      if (holder.parentNode) document.body.removeChild(holder);
      setLoading(false); toast('Could not generate QR'); $('qrFrame').classList.add('empty'); return;
    }
    var tries = 0;
    var poll = setInterval(function () {
      tries++;
      var canvas = holder.querySelector('canvas');
      var img = holder.querySelector('img');
      if (canvas || img || tries >= 30) {
        clearInterval(poll);
        function cleanup() { if (holder.parentNode) document.body.removeChild(holder); setLoading(false); }
        if (canvas) {
          postProcess(canvas, size, marginExtra, bg).then(function (c) { finish(c); cleanup(); }).catch(function () { finish(canvas); cleanup(); });
        } else if (img) {
          var c = document.createElement('canvas'); c.width = size; c.height = size;
          var ctx = c.getContext('2d');
          var image = new Image();
          image.onload = function () {
            ctx.fillStyle = bg; ctx.fillRect(0, 0, size, size); ctx.drawImage(image, 0, 0, size, size);
            postProcess(c, size, marginExtra, bg).then(function (out) { finish(out); cleanup(); }).catch(function () { finish(c); cleanup(); });
          };
          image.onerror = function () {
            $('qrcode').appendChild(img.cloneNode(true)); $('exportRow').style.display = 'flex';
            $('metaText').textContent = size + ' × ' + size; cleanup(); toast('QR ready');
          };
          image.src = img.src;
        } else {
          cleanup(); $('qrFrame').classList.add('empty'); toast('Generation failed — refresh page');
        }
      }
    }, 20);
  }

  function postProcess(src, baseSize, marginModules, bg) {
    return new Promise(function (resolve) {
      var pad = Math.max(0, (marginModules - 2) * Math.floor(baseSize / 28));
      var outW = baseSize + pad * 2, outH = baseSize + pad * 2;
      var out = document.createElement('canvas'); out.width = outW; out.height = outH;
      var ctx = out.getContext('2d');
      ctx.fillStyle = bg; ctx.fillRect(0, 0, outW, outH);
      ctx.drawImage(src, pad, pad, baseSize, baseSize);
      if ($('useGradient').checked) applyGradientOverlay(ctx, out, pad, baseSize);
      if (!logoDataUrl) { resolve(out); return; }
      var logo = new Image();
      logo.onload = function () {
        var pct = (parseInt($('logoSize').value, 10) || 18) / 100;
        var logoSize = Math.floor(baseSize * pct);
        var x = pad + (baseSize - logoSize) / 2, y = pad + (baseSize - logoSize) / 2;
        var padding = Math.max(4, Math.floor(logoSize * 0.1)), r = 6;
        var px = x - padding, py = y - padding, pw = logoSize + padding * 2, ph = logoSize + padding * 2;
        ctx.fillStyle = bg;
        ctx.beginPath(); ctx.moveTo(px + r, py);
        ctx.arcTo(px + pw, py, px + pw, py + ph, r); ctx.arcTo(px + pw, py + ph, px, py + ph, r);
        ctx.arcTo(px, py + ph, px, py, r); ctx.arcTo(px, py, px + pw, py, r); ctx.closePath(); ctx.fill();
        ctx.drawImage(logo, x, y, logoSize, logoSize);
        resolve(out);
      };
      logo.onerror = function () { resolve(out); };
      logo.src = logoDataUrl;
    });
  }

  function applyGradientOverlay(ctx, canvas, pad, baseSize) {
    try {
      var imgData = ctx.getImageData(pad, pad, baseSize, baseSize);
      var data = imgData.data;
      var g1 = hexToRgb($('gradColor1').value), g2 = hexToRgb($('gradColor2').value), bg = hexToRgb($('bgColor').value);
      for (var i = 0; i < data.length; i += 4) {
        var dr = Math.abs(data[i] - bg.r), dg = Math.abs(data[i + 1] - bg.g), db = Math.abs(data[i + 2] - bg.b);
        if (dr + dg + db > 80) {
          var px = (i / 4) % baseSize, t = px / baseSize;
          data[i] = Math.round(g1.r + (g2.r - g1.r) * t);
          data[i + 1] = Math.round(g1.g + (g2.g - g1.g) * t);
          data[i + 2] = Math.round(g1.b + (g2.b - g1.b) * t);
        }
      }
      ctx.putImageData(imgData, pad, pad);
    } catch (e) {}
  }
  function hexToRgb(hex) {
    hex = hex.replace('#', '');
    return { r: parseInt(hex.substring(0, 2), 16), g: parseInt(hex.substring(2, 4), 16), b: parseInt(hex.substring(4, 6), 16) };
  }

  function finish(canvas) {
    currentCanvas = canvas;
    $('qrcode').innerHTML = '';
    var display = document.createElement('canvas');
    display.width = canvas.width; display.height = canvas.height;
    display.getContext('2d').drawImage(canvas, 0, 0);
    if (display.width > 320) {
      var scale = 320 / display.width;
      display.style.width = '320px';
      display.style.height = Math.round(display.height * scale) + 'px';
    }
    $('qrcode').appendChild(display);
    currentCanvas = canvas;
    $('exportRow').style.display = 'flex';
    $('metaText').textContent = canvas.width + ' × ' + canvas.height + ' px · ' + currentType.toUpperCase() + ' · ' + $('level').value;
    toast('QR ready 🎉');
  }

  $('generateBtn').addEventListener('click', generateQR);
  $('clearBtn').addEventListener('click', function () {
    Object.keys(contentFields).forEach(function (k) {
      var el = contentFields[k]; if (!el) return;
      if (el.type === 'checkbox') el.checked = false; else el.value = '';
    });
    $('qrName').value = ''; logoDataUrl = null; $('logoInput').value = ''; $('logoRow').classList.remove('show');
    $('qrcode').innerHTML = ''; $('qrFrame').classList.add('empty'); $('exportRow').style.display = 'none';
    $('metaText').textContent = ''; currentCanvas = null; currentPayload = ''; toast('Cleared');
  });

  function downloadCanvas(format) {
    if (!currentCanvas) { toast('Generate QR first'); return; }
    var name = (defaultName().replace(/[^\w\-]+/g, '_') || 'qr') + '-' + Date.now();
    if (format === 'svg') { downloadSVG(name); return; }
    var mime = format === 'jpg' ? 'image/jpeg' : 'image/png';
    var ext = format === 'jpg' ? 'jpg' : 'png';
    try {
      var link = document.createElement('a');
      link.download = name + '.' + ext;
      if (format === 'jpg') {
        var c = document.createElement('canvas'); c.width = currentCanvas.width; c.height = currentCanvas.height;
        var ctx = c.getContext('2d');
        ctx.fillStyle = $('bgColor').value || '#ffffff';
        ctx.fillRect(0, 0, c.width, c.height); ctx.drawImage(currentCanvas, 0, 0);
        link.href = c.toDataURL(mime, 0.92);
      } else {
        link.href = currentCanvas.toDataURL(mime);
      }
      document.body.appendChild(link); link.click(); document.body.removeChild(link);
      toast(ext.toUpperCase() + ' downloaded');
    } catch (e) { toast('Download failed'); }
  }
  function downloadSVG(name) {
    var dataUrl = currentCanvas.toDataURL('image/png');
    var w = currentCanvas.width, h = currentCanvas.height;
    var svg = '<?xml version="1.0" encoding="UTF-8"?>\n<svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" width="' + w + '" height="' + h + '" viewBox="0 0 ' + w + ' ' + h + '">\n<image width="' + w + '" height="' + h + '" xlink:href="' + dataUrl + '"/>\n</svg>';
    var blob = new Blob([svg], { type: 'image/svg+xml;charset=utf-8' });
    var url = URL.createObjectURL(blob);
    var link = document.createElement('a'); link.download = name + '.svg'; link.href = url;
    document.body.appendChild(link); link.click(); document.body.removeChild(link); URL.revokeObjectURL(url);
    toast('SVG downloaded');
  }
  $('dlPng').addEventListener('click', function () { downloadCanvas('png'); });
  $('dlJpg').addEventListener('click', function () { downloadCanvas('jpg'); });
  $('dlSvg').addEventListener('click', function () { downloadCanvas('svg'); });
  $('copyBtn').addEventListener('click', function () {
    if (!currentCanvas) { toast('Generate QR first'); return; }
    if (navigator.clipboard && window.ClipboardItem) {
      currentCanvas.toBlob(function (blob) {
        if (!blob) { toast('Copy failed'); return; }
        navigator.clipboard.write([new ClipboardItem({ 'image/png': blob })])
          .then(function () { toast('Copied to clipboard'); })
          .catch(function () { toast('Copy not supported — use download'); });
      }, 'image/png');
    } else toast('Copy not supported — use download');
  });
  $('shareBtn').addEventListener('click', async function () {
    if (!currentCanvas) { toast('Generate QR first'); return; }
    try {
      if (navigator.share && navigator.canShare) {
        var blob = await new Promise(function (res) { currentCanvas.toBlob(res, 'image/png'); });
        var file = new File([blob], 'qr.png', { type: 'image/png' });
        if (navigator.canShare({ files: [file] })) {
          await navigator.share({ files: [file], title: defaultName(), text: currentPayload });
          toast('Shared'); return;
        }
      }
      if (navigator.clipboard) { await navigator.clipboard.writeText(currentPayload); toast('Payload copied (share not available)'); }
      else toast('Share not available');
    } catch (e) { if (e.name !== 'AbortError') toast('Share cancelled or failed'); }
  });

  function loadHistory() {
    try { var raw = localStorage.getItem(STORAGE_KEY); historyItems = raw ? JSON.parse(raw) : []; } catch (e) { historyItems = []; }
    renderHistory();
  }
  function saveHistory() {
    try {
      if (historyItems.length > 40) historyItems = historyItems.slice(0, 40);
      localStorage.setItem(STORAGE_KEY, JSON.stringify(historyItems));
    } catch (e) { toast('Storage full — clear some history'); }
  }
  function renderHistory() {
    var grid = $('historyGrid');
    if (!historyItems.length) {
      grid.innerHTML = '<div class="empty-history">No saved QR codes yet. Generate and click <strong>Save</strong>.</div>';
      return;
    }
    grid.innerHTML = historyItems.map(function (item) {
      return '<div class="history-item" data-id="' + item.id + '" title="Click to load">' +
        '<div class="thumb"><img src="' + item.thumb + '" alt="" /></div>' +
        '<div class="name">' + escapeHtml(item.name) + '</div>' +
        '<div class="meta">' + item.type.toUpperCase() + ' · ' + formatDate(item.ts) + '</div>' +
        '<div class="actions">' +
          '<button type="button" class="btn btn-ghost btn-sm" data-act="load">Load</button>' +
          '<button type="button" class="btn btn-ghost btn-sm" data-act="dup">Copy</button>' +
          '<button type="button" class="btn btn-ghost btn-sm" data-act="rename">✎</button>' +
          '<button type="button" class="btn btn-ghost btn-sm btn-danger" data-act="del">✕</button>' +
        '</div></div>';
    }).join('');
  }
  function escapeHtml(s) { return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }
  function formatDate(ts) { try { return new Date(ts).toLocaleDateString(undefined, { month: 'short', day: 'numeric' }); } catch (e) { return ''; } }

  $('saveBtn').addEventListener('click', function () {
    if (!currentCanvas || !currentPayload) { toast('Generate a QR first'); return; }
    var thumbC = document.createElement('canvas');
    var tw = 120;
    thumbC.width = tw; thumbC.height = Math.round(currentCanvas.height * (tw / currentCanvas.width));
    thumbC.getContext('2d').drawImage(currentCanvas, 0, 0, thumbC.width, thumbC.height);
    var item = {
      id: 'qr_' + Date.now() + '_' + Math.random().toString(36).slice(2, 7),
      name: defaultName(), type: currentType, payload: currentPayload,
      thumb: thumbC.toDataURL('image/png'),
      fg: $('fgColor').value, bg: $('bgColor').value, size: parseInt($('size').value, 10),
      level: $('level').value, margin: parseInt($('margin').value, 10),
      useGradient: $('useGradient').checked, g1: $('gradColor1').value, g2: $('gradColor2').value,
      logo: logoDataUrl, logoSize: parseInt($('logoSize').value, 10), ts: Date.now()
    };
    historyItems.unshift(item); saveHistory(); renderHistory(); toast('Saved to history');
  });

  $('historyGrid').addEventListener('click', function (e) {
    var itemEl = e.target.closest('.history-item');
    if (!itemEl) return;
    var id = itemEl.getAttribute('data-id');
    var item = historyItems.find(function (h) { return h.id === id; });
    if (!item) return;
    var act = e.target.getAttribute('data-act');
    if (act === 'del') {
      historyItems = historyItems.filter(function (h) { return h.id !== id; });
      saveHistory(); renderHistory(); toast('Deleted'); return;
    }
    if (act === 'rename') {
      renameId = id; $('renameInput').value = item.name;
      $('renameModal').classList.add('show'); $('renameInput').focus(); return;
    }
    if (act === 'dup') {
      var copy = JSON.parse(JSON.stringify(item));
      copy.id = 'qr_' + Date.now() + '_' + Math.random().toString(36).slice(2, 7);
      copy.name = item.name + ' (copy)'; copy.ts = Date.now();
      historyItems.unshift(copy); saveHistory(); renderHistory(); toast('Duplicated'); return;
    }
    loadItem(item);
  });

  function loadItem(item) {
    var tab = document.querySelector('.type-tab[data-type="' + item.type + '"]');
    if (tab) tab.click();
    $('fgColor').value = item.fg || '#1e1b4b'; $('bgColor').value = item.bg || '#ffffff';
    $('size').value = String(item.size || 256); $('level').value = item.level || 'M';
    $('margin').value = item.margin != null ? item.margin : 2; $('marginVal').textContent = $('margin').value;
    $('useGradient').checked = !!item.useGradient; $('gradRow').style.display = item.useGradient ? 'grid' : 'none';
    if (item.g1) $('gradColor1').value = item.g1; if (item.g2) $('gradColor2').value = item.g2;
    $('qrName').value = item.name || '';
    if (item.logo) {
      logoDataUrl = item.logo; $('logoImg').src = item.logo; $('logoRow').classList.add('show');
      if (item.logoSize) { $('logoSize').value = item.logoSize; $('logoSizeVal').textContent = item.logoSize + '%'; }
    } else { logoDataUrl = null; $('logoRow').classList.remove('show'); }
    restoreContentFromPayload(item);
    setTimeout(generateQR, 50);
    toast('Loaded: ' + item.name);
  }

  function restoreContentFromPayload(item) {
    var p = item.payload || '';
    try {
      switch (item.type) {
        case 'url': contentFields.url.value = p; break;
        case 'text': contentFields.text.value = p; break;
        case 'whatsapp':
          var m = p.match(/wa\.me\/(\d+)/); if (m) contentFields.waPhone.value = m[1];
          var tm = p.match(/text=([^&]+)/); if (tm) contentFields.waMsg.value = decodeURIComponent(tm[1]);
          break;
        case 'email':
          var em = p.replace(/^mailto:/, '').split('?');
          contentFields.emailTo.value = em[0] || '';
          if (em[1]) { var params = new URLSearchParams(em[1]); contentFields.emailSub.value = params.get('subject') || ''; contentFields.emailBody.value = params.get('body') || ''; }
          break;
        case 'phone': contentFields.phoneNum.value = p.replace(/^tel:/, ''); break;
        case 'sms':
          var sm = p.replace(/^sms:/, '').split('?');
          contentFields.smsPhone.value = sm[0] || '';
          if (sm[1]) { var sp = new URLSearchParams(sm[1]); contentFields.smsBody.value = sp.get('body') || ''; }
          break;
        case 'wifi':
          var ss = p.match(/S:([^;]*)/); var pw = p.match(/P:([^;]*)/); var te = p.match(/T:([^;]*)/);
          if (ss) contentFields.wifiSsid.value = ss[1].replace(/\\(.)/g, '$1');
          if (pw) contentFields.wifiPass.value = pw[1].replace(/\\(.)/g, '$1');
          if (te) contentFields.wifiEnc.value = te[1];
          contentFields.wifiHidden.checked = /H:true/.test(p);
          break;
        case 'vcard':
          var fn = p.match(/FN:([^\n\r]+)/);
          if (fn) { var parts = fn[1].trim().split(' '); contentFields.vcFirst.value = parts[0] || ''; contentFields.vcLast.value = parts.slice(1).join(' ') || ''; }
          break;
      }
    } catch (e) {}
  }

  $('renameConfirm').addEventListener('click', function () {
    var name = $('renameInput').value.trim();
    if (!name || !renameId) return;
    var item = historyItems.find(function (h) { return h.id === renameId; });
    if (item) { item.name = name; saveHistory(); renderHistory(); toast('Renamed'); }
    $('renameModal').classList.remove('show'); renameId = null;
  });
  $('renameCancel').addEventListener('click', function () { $('renameModal').classList.remove('show'); renameId = null; });
  $('clearHistoryBtn').addEventListener('click', function () {
    if (!historyItems.length) return;
    if (!confirm('Delete all saved QR codes?')) return;
    historyItems = []; saveHistory(); renderHistory(); toast('History cleared');
  });
  $('helpBtn').addEventListener('click', function () { $('helpModal').classList.add('show'); });
  $('helpClose').addEventListener('click', function () { $('helpModal').classList.remove('show'); });

  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape') {
      $('renameModal').classList.remove('show'); $('helpModal').classList.remove('show'); $('onboard').classList.remove('show');
    }
    if (e.key === '?' && !e.target.matches('input, textarea, select')) { e.preventDefault(); $('helpModal').classList.add('show'); }
    if ((e.key === 't' || e.key === 'T') && !e.target.matches('input, textarea, select')) { e.preventDefault(); toggleTheme(); }
    if (e.key === 'Enter' && (e.ctrlKey || e.metaKey)) { e.preventDefault(); generateQR(); }
  });

  loadHistory();
  contentFields.url.focus();
})();

</script>
</body>
</html>
